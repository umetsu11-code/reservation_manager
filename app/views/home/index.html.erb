<body>
<p>Potepan Shareで今まで見たこのない旅をしよう</p>

<!-- 検索フォーム -->
<div>
  <%= search_form_for @q, url: rooms_path, method: :get do |f| %>
    <div>
      <%= f.text_field :address_cont, placeholder: "エリア名を入力", class: "form-control" %>
    </div>
    <%= f.submit "検索", class: "btn btn-primary mt-2" %>
  <% end %>
</div>
  <!-- 結果表示エリア 検索結果を表示させる際に画面遷移を伴うように のち修正-->
  <div>
  <h1>おすすめのエリア</h1>
  <div>
      <%= link_to "東京", rooms_path(area: "東京"), class: "btn btn-primary mt-2" %>
      <%= link_to "大阪", rooms_path(area: "大阪"), class: "btn btn-primary mt-2" %>
      <%= link_to "京都", rooms_path(area: "京都"), class: "btn btn-primary mt-2" %>
      <%= link_to "札幌", rooms_path(area: "札幌"), class: "btn btn-primary mt-2" %>
    </div>
  </div>
</body>
