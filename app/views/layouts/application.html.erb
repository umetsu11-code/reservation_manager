<!DOCTYPE html>
<html>
  <head>
    <title>宿泊予約アプリ</title>
      <meta name="viewport" content="width=device-width,initial-scale=1">
      <%= csrf_meta_tags %>
      <%= csp_meta_tag %>
      <!--以下にbootstrapを記述-->
      <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
      <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
    </head>

  <!--body全体をフレックスボックスに指定-->
  <body class="d-flex flex-column min-vh-100">
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container-fluid">
    <a class="navbar-brand" href="#"><img src="/assets/logo.png" alt="Logo" class="d-inline-block align-text-top" style="height: 40px;"></a>
 
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <% if user_signed_in? %>
          <li class="nav-item">
          <!--ログイン後「アカウント設定」ボタン押下で画面遷移するように-->
            <%= link_to "アカウント設定", edit_user_registration_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "ログアウト", destroy_user_session_path, method: :delete, class: "nav-link" %>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "ログイン", new_user_session_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "新規登録", new_user_registration_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
  <!-- メインコンテンツ -->
  <main class="flex-grow-1">
  <%= yield %>
  </main>
  <!-- フッター -->
  <%= render 'layouts/footer' %>
  </body>
</html>
