<%= form_with model: @user, url: update_profile_user_path(@user), method: :patch do |f| %>
    <div>
    <%= f.label :icon, "アイコン画像" %>
    <%= f.file_field :icon, class: "form-control" %>
  </div>
    
   <div>
    <%= f.label :name, "名前" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div>
    <%= f.label :introduction, "自己紹介" %>
    <%= f.text_area :introduction, class: "form-control" %>
  </div>

  <div>
    <%= f.submit "更新", class: "btn btn-primary" %>
  </div>
<%= link_to "戻る", request.referer || root_path, class: "btn btn-secondary mt-3" %>
<% end %>
