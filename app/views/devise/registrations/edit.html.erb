<h2>プロフィール編集 </h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <!-- アイコン画像 -->
  <div>
    <%= f.label :icon, "アイコン画像" %>
    <%= f.file_field :icon, accept: "image/*" %>
  </div>

  <div>
    <%= f.submit "更新", class: "btn btn-primary" %>
  </div>

  <!-- メールアドレス -->
  <div class="field">
    <%= f.label :email %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <!-- 名前 -->
  <div class="field">
    <%= f.label :name, "名前" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <!-- 自己紹介 -->
  <div class="field">
    <%= f.label :introduction, "自己紹介" %>
    <%= f.text_area :introduction, class: "form-control" %>
  </div>


  <!-- 新しいパスワード -->
  <div class="field">
    <%= f.label :password, "変更後パスワード※変更する場合のみ" %>
    <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
  </div>

  <!-- 新しいパスワードの確認 -->
  <div class="field">
    <%= f.label :password_confirmation, "確認用バスワード※変更する場合のみ" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
  </div>

  <!-- 現在のパスワード -->
  <div class="field">
    <%= f.label :current_password, "現在のパスワード（必須）" %>
    <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control" %>
  </div>

  <!-- 更新ボタン -->
  <div class="actions">
    <%= f.submit "更新", class: "btn btn-primary" %>
  </div>
<% end %>

<% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
  <div>
    現在確認待ちのメールアドレス: <%= resource.unconfirmed_email %>
  </div>
<% end %>

<h3>アカウントの削除</h3>
<div>

  <%= button_to "アカウントを削除", registration_path(resource_name), data: { confirm: "本当に削除しますか？" }, method: :delete, class: "btn btn-danger" %>
</div>
<div>
  <%= link_to "アカウント情報", edit_user_registration_path, class: "btn btn-primary" %>
  <%= link_to "プロフィール編集", edit_profile_user_path(current_user), class: "btn btn-secondary" %>
</div>

<%= link_to "戻る", root_path, class: "btn btn-secondary mt-3" %>

