<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <div>
  <%= link_to "アカウント", edit_user_registration_path, class: "btn btn-primary" %>
  <%= link_to "プロフィール", edit_profile_user_path(current_user), class: "btn btn-secondary" %>
</div>
 
  <!-- 新しいパスワード -->
  <div class="field">
    <%= f.label :password, "変更後パスワード※変更する場合のみ" %>
    <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
  </div>

  <!-- 新しいパスワードの確認 -->
  <div class="field">
    <%= f.label :password_confirmation, "確認用バスワード※変更する場合のみ" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
  </div>

  <!-- 現在のパスワード -->
  <div class="field">
    <%= f.label :current_password, "現在のパスワード" %>
    <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control" %>
  </div>

  <!-- 更新ボタン -->
  <div class="actions">
    <%= f.submit "更新", class: "btn btn-primary" %>
  </div>
<% end %>

<% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
  <div>
    現在確認待ちのメールアドレス: <%= resource.unconfirmed_email %>
  </div>
<% end %>

</div>


<%= link_to "戻る", root_path, class: "btn btn-secondary mt-3" %>

