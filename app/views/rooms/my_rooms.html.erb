<h2>登録済み一覧</h2>

<% @rooms.each do |room| %>
  <h3><%= link_to room.name, room_path(room) %></h3>
  <p><%= room.description %></p>
  <li>
  <!-- デフォルト画像対応 -->
  <div>
    <% if room.image_url.present? %>
      <img src="<%= room.image_url %>" alt="<%= room.name %>" width="300">
    <% else %>
      <%= image_tag 'default-image-4e0ac6b8d01335b5b22fe6586af13644ae51dddb6aeabf35b9174e80f13cd09d', alt: room.name, width: 300 %>
    <% end %>
  <p>施設名<%= room.name %></p>
  <p>紹介文<%= room.description %></p>
  <p>料金: <%= room.price %>円/日</p>
  </li>

  <!-- 削除ボタンを表示 -->
  <%= button_to "施設を削除", room_path(room), method: :delete, data: { confirm: "本当にこの施設を削除しますか？" }, class: "btn btn-danger" %>
<% end %>