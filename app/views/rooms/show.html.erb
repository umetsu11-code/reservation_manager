<img src="<%= @room.image_url %>" alt="<%= @room.name %>" width="300">
<p>料金: <%= @room.price %>円/日</p>
<p>住所: <%= @room.address %></p>
<p><%= @room.description %></p>
<%= form_with model: [@room, @room.reservations.build], local: true do |f| %>
  <div>
    <%= f.label :check_in_date, "チェックイン" %>
    <%= f.date_field :check_in_date, class: "form-control" , required: true %>
  </div>
  <div>
    <%= f.label :check_out_date, "チェックアウト" %>
    <%= f.date_field :check_out_date, class: "form-control" , required: true %>
  </div>
  <div>
    <%= f.label :number_of_guests, "人数" %>
    <%= f.number_field :number_of_guests, value: 1, min: 1, class: "form-control" , required: true %>
  </div>
  <div>
    <%= f.submit "予約する", class: "btn btn-primary mt-2" %>
  </div>
<% end %>
<p><%= link_to "戻る", request.referer || rooms_path%></p>
